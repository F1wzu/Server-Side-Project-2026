
# Copy this file to .env and fill in the values

# --- App ---
# development, test or production (temp)
NODE_ENV=development
PORT=3000

# --- Database ---
# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# With Docker Compose, PASSWORD is the POSTGRES_PASSWORD you set below.
DATABASE_URL=postgresql://painaidee:YOUR_DB_PASSWORD@127.0.0.1:5432/painaidee_dev
# A second database used only by `npm test`. The tests erase it on every run.
TEST_DATABASE_URL=postgresql://painaidee:YOUR_DB_PASSWORD@127.0.0.1:5432/painaidee_test

# --- Sessions ---
# Random value of at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Photo storage ---
# local = storage/uploads. cloud = cloud storage (production). not picked yet
STORAGE_DRIVER=

# --- Production only (leave empty in development) ---
# Public HTTPS address without a trailing slash, e.g. https://example.com
PUBLIC_ORIGIN=
# Set when the app runs behind the host's proxy (Render, Railway, nginx ...),
# usually 1. Required there: without it the app thinks every request is
# plain HTTP, never sets the secure login cookie, and nobody can log in.
# Allowed: a number, true, false, or a list such as loopback, 10.0.0.0/8
TRUST_PROXY=

# --- Docker Compose only (docker-compose.yaml) ---
# Password for the database that Docker creates. Use the same value in the
# two connection strings above.
POSTGRES_PASSWORD=
