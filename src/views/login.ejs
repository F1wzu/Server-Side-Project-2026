<%- include('partials/head') %>
<div class="container auth-layout page-content">
  <%- include('partials/auth-intro') %>

  <section class="panel auth-panel" aria-labelledby="auth-heading">
    <h2 id="auth-heading">เข้าสู่ระบบ</h2>
    <p class="meta">ยินดีต้อนรับกลับมาสำรวจย่านของเรา</p>
    <% if (formError) { %>
    <div class="form-error" role="alert" id="form-error" tabindex="-1"><%= formError %></div>
    <% } %>
    <form method="post" action="/login" class="stack-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <input type="hidden" name="next" value="<%= next %>">
      <%- include('partials/field', { name: 'email', label: 'อีเมล', type: 'email', value: values.email, error: errors.email, autocomplete: 'email' }) %>
      <%- include('partials/field', { name: 'password', label: 'รหัสผ่าน', type: 'password', error: errors.password, autocomplete: 'current-password' }) %>
      <button class="button button-primary button-block" type="submit">เข้าสู่ระบบ</button>
    </form>
    <p class="auth-switch">
      ยังไม่มีบัญชี?
      <a class="text-link" href="/register<%= next ? '?next=' + encodeURIComponent(next) : '' %>">สมัครสมาชิก</a>
    </p>
    <p class="small-note">อีเมลใช้สำหรับเข้าสู่ระบบและไม่แสดงในรีวิวสาธารณะ</p>
  </section>
</div>
<%- include('partials/foot') %>
