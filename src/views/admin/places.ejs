<%- include('../partials/head') %>
<%
  const statusTabs = [['all', 'ทั้งหมด'], ['published', 'เผยแพร่'], ['unpublished', 'ซ่อนอยู่']];
%>
<div class="container page-content">
  <%- include('../partials/admin-nav') %>
  <div class="page-heading">
    <h1>จัดการสถานที่</h1>
    <p>แก้ไขข้อมูล เวลาเปิดปิด ลำดับแนะนำ และควบคุมการเผยแพร่</p>
  </div>

  <div class="form-actions">
    <a class="button button-primary" href="/admin/places/new"><%- icon('plus', 18) %>เพิ่มสถานที่</a>
  </div>

  <form class="filter-panel" method="get" action="/admin/places">
    <div class="field search-field">
      <label for="q">ค้นหาจากชื่อสถานที่</label>
      <input id="q" name="q" type="search" value="<%= filters.q %>" maxlength="200">
    </div>
    <div class="field">
      <label for="status">การเผยแพร่</label>
      <select id="status" name="status">
        <% statusTabs.forEach(([value, label]) => { %>
        <option value="<%= value %>" <%= filters.status === value ? 'selected' : '' %>><%= label %></option>
        <% }) %>
      </select>
    </div>
    <button class="button button-primary" type="submit">ค้นหา</button>
  </form>

  <p class="meta list-count"><%= result.pagination.total %> สถานที่</p>
  <% if (result.data.length) { %>
  <div class="table-shell">
    <table>
      <thead>
        <tr>
          <th scope="col">สถานที่</th>
          <th scope="col">สถานะ</th>
          <th scope="col">ลำดับแนะนำ</th>
          <th scope="col">คะแนน</th>
          <th scope="col">หมุดแผนที่</th>
          <th scope="col">เวลาเปิดปิด</th>
          <th scope="col">จัดการ</th>
        </tr>
      </thead>
      <tbody>
        <% result.data.forEach((place) => { %>
        <tr>
          <td><strong><%= place.name %></strong><span class="meta table-meta"><%= place.category.name %></span></td>
          <td data-label="สถานะ"><span class="status status-<%= place.status %>"><%= place.status === 'published' ? 'เผยแพร่' : 'ซ่อนอยู่' %></span></td>
          <td data-label="ลำดับแนะนำ"><%= place.featuredOrder ?? '—' %></td>
          <td data-label="คะแนน"><%= place.ratingAvg === null ? '—' : place.ratingAvg.toFixed(1) + ' (' + place.ratingCount + ')' %></td>
          <td data-label="หมุดแผนที่"><%= place.hasPin ? 'มีแล้ว' : 'ยังไม่มี' %></td>
          <td data-label="เวลาเปิดปิด"><%= place.hasHours ? 'มีแล้ว' : 'ยังไม่ทราบ' %></td>
          <td>
            <a class="text-link" href="/admin/places/<%= place.id %>/edit" aria-label="แก้ไข <%= place.name %>">แก้ไข</a>
            <form method="post" action="/admin/places/<%= place.id %>/status" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
              <input type="hidden" name="status" value="<%= place.status === 'published' ? 'unpublished' : 'published' %>">
              <button class="button button-small button-outline" type="submit" aria-label="<%= (place.status === 'published' ? 'ซ่อน ' : 'เผยแพร่ ') + place.name %>"><%= place.status === 'published' ? 'ซ่อน' : 'เผยแพร่' %></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div class="empty-state"><h2>ไม่พบสถานที่</h2><p>ลองเปลี่ยนคำค้นหาหรือตัวกรอง</p></div>
  <% } %>
  <%- include('../partials/pagination', { pagination: result.pagination, pageLink }) %>
</div>
<%- include('../partials/foot') %>
