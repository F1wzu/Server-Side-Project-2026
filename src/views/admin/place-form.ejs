<%- include('../partials/head') %>
<%
  const editing = Boolean(place);
%>
<div class="container page-content">
  <%- include('../partials/admin-nav') %>
  <nav class="breadcrumb" aria-label="ตำแหน่งหน้า">
    <a href="/admin/places">จัดการสถานที่</a><%- icon('chevron', 16) %>
    <span><%= editing ? 'แก้ไข ' + place.name : 'เพิ่มสถานที่' %></span>
  </nav>
  <% if (editing) { %><%- include('../partials/admin-place-tabs', { place, current: 'edit' }) %><% } %>
  <div class="page-heading">
    <h1><%= editing ? 'แก้ไขสถานที่' : 'เพิ่มสถานที่โดยตรง' %></h1>
    <p>สถานที่ที่บันทึกจากหน้านี้ไม่ต้องรอการอนุมัติ ปักหมุดไม่บังคับ แต่ถ้าระบุต้องอยู่ในเขตลาดกระบัง</p>
  </div>

  <% if (formError) { %>
  <div class="form-error" role="alert" id="form-error" tabindex="-1">
    <%= formError %>
    <% if (Object.keys(errors).length) { %>
    <ul>
      <% Object.entries(errors).forEach(([field, message]) => { %><li><%= message %></li><% }) %>
    </ul>
    <% } %>
    <% if (!editing && !errors.photo && values && Object.keys(values).length > 1) { %><p class="small-note">ถ้าแนบรูปไว้ กรุณาเลือกรูปอีกครั้ง</p><% } %>
  </div>
  <% } %>

  <form class="panel submission-form stack-form" method="post" enctype="multipart/form-data"
        action="<%= editing ? '/admin/places/' + place.id : '/admin/places' %>" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">

    <%# When editing, photos are managed on the "รูปภาพ" tab, so the form has no photo field. %>
    <%- include('../partials/place-fields', { values, errors, categories, bounds, pinRequired: false, photosLink: editing ? '/admin/places/' + place.id + '/photos' : null }) %>

    <fieldset class="field-group">
      <legend>การเผยแพร่</legend>
      <div class="field-pair">
        <div class="field">
          <label for="status">สถานะ</label>
          <select id="status" name="status" <%- errors.status ? 'aria-invalid="true"' : '' %>>
            <option value="published" <%= values.status !== 'unpublished' ? 'selected' : '' %>>เผยแพร่</option>
            <option value="unpublished" <%= values.status === 'unpublished' ? 'selected' : '' %>>ซ่อนจากหน้าสาธารณะ</option>
          </select>
          <% if (errors.status) { %><p class="field-error"><%= errors.status %></p><% } %>
        </div>
        <div class="field">
          <label for="featuredOrder">ลำดับแนะนำบนหน้าแรก (1-999)</label>
          <input id="featuredOrder" name="featuredOrder" inputmode="numeric" maxlength="3" value="<%= values.featuredOrder ?? '' %>" placeholder="เว้นว่างถ้าไม่แนะนำ" <%- errors.featuredOrder ? 'aria-invalid="true"' : '' %>>
          <% if (errors.featuredOrder) { %><p class="field-error"><%= errors.featuredOrder %></p><% } %>
          <small>จัดลำดับทั้งหมดได้ง่ายกว่าที่หน้า <a class="text-link" href="/admin/featured">ทีมงานชวนไป</a></small>
        </div>
      </div>
      <% if (editing) { %><p class="meta">คะแนนรีวิวคำนวณจากรีวิวของสมาชิก แก้ไขที่นี่ไม่ได้</p><% } %>
    </fieldset>

    <div class="form-actions">
      <a class="button button-outline" href="/admin/places">ยกเลิก</a>
      <button class="button button-primary" type="submit"><%= editing ? 'บันทึกการแก้ไข' : 'เพิ่มสถานที่' %></button>
    </div>
  </form>

  <% if (editing) { %>
  <%# A separate form: forms cannot be nested. Hiding (the status above) is the usual way to take a place down. %>
  <details class="danger-zone">
    <summary>ลบสถานที่นี้ถาวร</summary>
    <p>ปกติให้ใช้ "ซ่อนจากหน้าสาธารณะ" ด้านบน ซึ่งกลับมาเผยแพร่ได้ ส่วนการลบถาวรมีไว้สำหรับสถานที่ที่เพิ่มผิดหรือข้อมูลทดสอบ
      ใช้ได้เฉพาะสถานที่ที่ยังไม่มีใครรีวิว ข้อมูล เวลาเปิดปิด รูป การบันทึกของสมาชิก รายการแจ้งข้อมูลผิด
      และคำขอของสมาชิกที่สร้างสถานที่นี้ (ถ้ามี) จะถูกลบทั้งหมด และกู้คืนไม่ได้</p>
    <form method="post" action="/admin/places/<%= place.id %>/delete">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <button class="button button-danger" type="submit">ยืนยันลบ "<%= place.name %>" ถาวร</button>
    </form>
  </details>
  <% } %>
</div>
<%- include('../partials/foot') %>
