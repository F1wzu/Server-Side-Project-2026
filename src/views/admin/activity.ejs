<%- include('../partials/head') %>
<div class="container page-content">
  <%- include('../partials/admin-nav') %>
  <div class="page-heading">
    <h1>บันทึกกิจกรรม</h1>
    <p>สิ่งที่เกิดขึ้นบนเว็บล่าสุด เรียงจากใหม่ไปเก่า: การสมัครสมาชิก คำขอ รีวิว และการแจ้งต่าง ๆ</p>
    <p class="meta">การซ่อน แก้ไขสถานที่ เปลี่ยนรูป หรือเปลี่ยนหมวดหมู่ ยังไม่ได้ถูกบันทึกเวลาไว้ จึงไม่แสดงที่นี่</p>
  </div>

  <nav class="tabs" aria-label="กรองตามประเภท">
    <% groups.forEach(({ key, label, href }) => { %>
    <a href="<%= href %>"<%- group === key ? ' aria-current="true"' : '' %>><%= label %></a>
    <% }) %>
  </nav>

  <p class="meta list-count"><%= result.pagination.total %> รายการ</p>

  <% if (result.pagination.total === 0) { %>
  <div class="empty-state">
    <%- icon('shield', 28) %>
    <h2>ยังไม่มีกิจกรรมในหมวดนี้</h2>
  </div>
  <% } else { %>
  <div class="table-shell">
    <table>
      <thead>
        <tr>
          <th scope="col">เวลา</th>
          <th scope="col">ผู้ทำ</th>
          <th scope="col">สิ่งที่ทำ</th>
          <th scope="col">เกี่ยวกับ</th>
          <th scope="col">หมายเหตุ</th>
        </tr>
      </thead>
      <tbody>
        <% result.data.forEach((entry) => { %>
        <tr>
          <td data-label="เวลา" class="table-date cell-nowrap"><%= dateTime(entry.at) %></td>
          <td data-label="ผู้ทำ"><% if (entry.actor && entry.actor.link) { %><a class="text-link" href="<%= entry.actor.link %>"><%= entry.actor.username %></a><% } else { %><%= entry.actor ? entry.actor.username : '-' %><% } %></td>
          <td data-label="สิ่งที่ทำ"><%= kindLabels[entry.kind] || entry.kind %></td>
          <td data-label="เกี่ยวกับ">
            <% if (entry.subject && entry.link) { %><a class="text-link" href="<%= entry.link %>"><%= entry.subject %></a><% } else { %><%= entry.subject || '-' %><% } %>
          </td>
          <td data-label="หมายเหตุ" class="preserve-lines"><%= entry.note || '-' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <%- include('../partials/pagination', { pagination: result.pagination, pageLink }) %>
</div>
<%- include('../partials/foot') %>
