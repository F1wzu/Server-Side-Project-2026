<%- include('../partials/head') %>
<%
  const statusLabels = { active: 'แสดงอยู่', deleted: 'ผู้เขียนลบแล้ว', removed: 'นำออกแล้ว' };
  const filters = [['all', 'ทั้งหมด'], ['active', 'แสดงอยู่'], ['removed', 'นำออกแล้ว'], ['deleted', 'ผู้เขียนลบแล้ว'], ['reported', 'ถูกรายงาน']];
  const reasonLabels = { spam: 'สแปมหรือโฆษณา', offensive: 'ไม่สุภาพหรือสร้างความเกลียดชัง', false_info: 'ข้อมูลเท็จหรือทำให้เข้าใจผิด', other: 'อื่น ๆ' };
  // Sent with each remove form, so the admin returns to the same search.
  const searchFields = Object.entries(search).filter(([key, value]) => value !== '' && value !== null && !(key === 'sort' && value === 'newest'));
%>
<div class="container narrow page-content">
  <%- include('../partials/admin-nav') %>
  <% if (place) { %>
  <nav class="breadcrumb" aria-label="ตำแหน่งหน้า">
    <a href="/admin/places">จัดการสถานที่</a><%- icon('chevron', 16) %>
    <span><%= place.name %></span>
  </nav>
  <%- include('../partials/admin-place-tabs', { place, current: 'reviews' }) %>
  <div class="page-heading">
    <h1>รีวิวของ <%= place.name %></h1>
    <p>นำรีวิวที่ไม่เหมาะสมออกพร้อมบันทึกเหตุผล คะแนนของสถานที่จะคำนวณใหม่ทันที รีวิวที่นำออกแล้วคืนค่าไม่ได้ และผู้เขียนจะเห็นเหตุผลนั้น</p>
    <p><a class="text-link" href="/places/<%= place.id %>">ดูหน้าสถานที่</a> · <a class="text-link" href="/admin/reviews">รีวิวทุกสถานที่</a></p>
  </div>
  <% } else { %>
  <div class="page-heading">
    <h1>ดูแลรีวิว</h1>
    <p>รีวิวจากทุกสถานที่ ใหม่สุดก่อน ถ้าต้องการดูทีละแห่ง ไปที่ <a class="text-link" href="/admin/places">จัดการสถานที่</a> แล้วกด "รีวิว" ของสถานที่นั้น รีวิวที่นำออกแล้วคืนค่าไม่ได้ และผู้เขียนจะเห็นเหตุผลนั้น</p>
  </div>
  <% } %>

  <nav class="tabs" aria-label="กรองตามสถานะ">
    <% filters.forEach(([key, label]) => { %>
    <a href="<%= statusLink(key) %>"<%- status === key ? ' aria-current="true"' : '' %>><%= label %></a>
    <% }) %>
  </nav>

  <%
    const sortOptions = [['newest', 'ใหม่สุดก่อน'], ['oldest', 'เก่าสุดก่อน'], ['lowest', 'คะแนนน้อยสุดก่อน'], ['highest', 'คะแนนมากสุดก่อน']];
    const searching = search.q || search.user || search.place || search.rating !== null || search.sort !== 'newest';
  %>
  <form class="filter-panel review-search" method="get" action="<%= listBase %>" role="search" aria-label="ค้นหารีวิว" data-collapsible="ค้นหารีวิว"<%- searching ? ' data-active' : '' %>>
    <% if (status !== 'all') { %><input type="hidden" name="status" value="<%= status %>"><% } %>
    <div class="field search-field">
      <label for="review-q">คำในรีวิว</label>
      <input id="review-q" name="q" type="search" value="<%= search.q %>" maxlength="200">
    </div>
    <div class="field">
      <label for="review-user">ชื่อผู้รีวิว</label>
      <input id="review-user" name="user" type="search" value="<%= search.user %>" maxlength="200">
    </div>
    <% if (!place) { %>
    <div class="field">
      <label for="review-place">ชื่อสถานที่</label>
      <input id="review-place" name="place" type="search" value="<%= search.place %>" maxlength="200">
    </div>
    <% } %>
    <div class="field">
      <label for="review-rating">คะแนน</label>
      <select id="review-rating" name="rating">
        <option value="">ทุกคะแนน</option>
        <% [5, 4, 3, 2, 1].forEach((stars) => { %>
        <option value="<%= stars %>" <%= search.rating === stars ? 'selected' : '' %>><%= stars %> ดาว</option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="review-sort">เรียงตาม</label>
      <select id="review-sort" name="sort">
        <% sortOptions.forEach(([value, label]) => { %>
        <option value="<%= value %>" <%= search.sort === value ? 'selected' : '' %>><%= label %></option>
        <% }) %>
      </select>
    </div>
    <div class="filter-actions">
      <button class="button button-primary" type="submit"><%- icon('search', 18) %>ค้นหา</button>
      <% if (searching) { %><a class="text-link" href="<%= listBase %><%= status === 'all' ? '' : '?status=' + status %>">ล้างการค้นหา</a><% } %>
    </div>
  </form>
  <p class="meta list-count"><%= result.pagination.total %> รีวิว<%= searching ? ' ที่ตรงกับการค้นหา' : '' %></p>

  <% if (result.pagination.total === 0) { %>
  <div class="empty-state">
    <%- icon('star', 28) %>
    <h2><%= searching ? 'ไม่พบรีวิวที่ตรงกับการค้นหา' : 'ไม่มีรีวิวในหมวดนี้' %></h2>
  </div>
  <% } %>

  <div class="review-management">
    <% result.data.forEach((review) => { %>
    <article class="panel managed-review">
      <div class="section-heading">
        <div>
          <% if (place) { %>
          <h2><%= review.user.username %></h2>
          <p class="meta"><%= date(review.createdAt) %></p>
          <% } else { %>
          <h2><a href="/admin/places/<%= review.place.id %>/reviews"><%= review.place.name %></a></h2>
          <p class="meta">โดย <%= review.user.username %> · <%= date(review.createdAt) %></p>
          <% } %>
        </div>
        <span class="status status-review-<%= review.status %>"><%= statusLabels[review.status] %></span>
      </div>
      <p><%- include('../partials/stars', { value: review.rating }) %></p>
      <p class="preserve-lines"><%= review.comment || 'ไม่มีข้อความเพิ่มเติม' %></p>

      <% if (review.status === 'removed') { %>
      <div class="feedback-panel"><strong>เหตุผลที่นำออก</strong><p><%= review.removedReason %></p></div>
      <% } %>

      <% if (review.reports && review.reports.length) { %>
      <div class="feedback-panel review-reports">
        <h3>ถูกรายงาน <%= review.reports.length %> ครั้ง</h3>
        <ul class="reply-list">
          <% review.reports.forEach((report) => { %>
          <li>
            <strong><%= reasonLabels[report.reason] %></strong> · <%= report.user.username %> · <time class="meta" datetime="<%= report.createdAt.toISOString() %>"><%= date(report.createdAt) %></time>
            <% if (report.details) { %><p class="preserve-lines small-note"><%= report.details %></p><% } %>
          </li>
          <% }) %>
        </ul>
        <form class="stack-form" action="/admin/reviews/<%= review.id %>/reports/dismiss" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <input type="hidden" name="status" value="<%= status %>">
          <input type="hidden" name="page" value="<%= result.pagination.page %>">
          <% searchFields.forEach(([key, value]) => { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% }) %>
          <% if (place) { %><input type="hidden" name="placeId" value="<%= place.id %>"><% } %>
          <button class="button button-outline button-small" type="submit">ไม่ดำเนินการ</button>
        </form>
      </div>
      <% } %>

      <% if (review.replies && review.replies.length) { %>
      <div class="review-replies">
        <h3 class="meta">ความเห็นตอบกลับ <%= review.replies.length %> รายการ</h3>
        <ul class="reply-list">
          <% review.replies.forEach((reply) => { %>
          <li class="reply">
            <div class="reply-top">
              <strong><%= reply.user.username %></strong>
              <time class="meta" datetime="<%= reply.createdAt.toISOString() %>"><%= date(reply.createdAt) %></time>
              <span class="status status-review-<%= reply.status %>"><%= statusLabels[reply.status] %></span>
            </div>
            <p class="preserve-lines"><%= reply.body %></p>
            <% if (reply.status === 'removed') { %><p class="small-note">เหตุผลที่นำออก: <%= reply.removedReason %></p><% } %>
            <% if (reply.reports && reply.reports.length) { %>
            <div class="feedback-panel review-reports">
              <h4>ความเห็นนี้ถูกรายงาน <%= reply.reports.length %> ครั้ง</h4>
              <ul class="reply-list">
                <% reply.reports.forEach((report) => { %>
                <li>
                  <strong><%= reasonLabels[report.reason] %></strong> · <%= report.user.username %> · <time class="meta" datetime="<%= report.createdAt.toISOString() %>"><%= date(report.createdAt) %></time>
                  <% if (report.details) { %><p class="preserve-lines small-note"><%= report.details %></p><% } %>
                </li>
                <% }) %>
              </ul>
              <form class="stack-form" action="/admin/replies/<%= reply.id %>/reports/dismiss" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                <input type="hidden" name="status" value="<%= status %>">
                <input type="hidden" name="page" value="<%= result.pagination.page %>">
                <% searchFields.forEach(([key, value]) => { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% }) %>
                <% if (place) { %><input type="hidden" name="placeId" value="<%= place.id %>"><% } %>
                <button class="button button-outline button-small" type="submit">ไม่ดำเนินการ<span class="sr-only">กับรายงานความเห็นของ <%= reply.user.username %></span></button>
              </form>
            </div>
            <% } %>
            <% if (reply.status === 'active') { %>
            <details>
              <summary>นำความเห็นนี้ออก</summary>
              <form class="stack-form" action="/admin/replies/<%= reply.id %>/remove" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                <input type="hidden" name="status" value="<%= status %>">
                <input type="hidden" name="page" value="<%= result.pagination.page %>">
                <% searchFields.forEach(([key, value]) => { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% }) %>
                <% if (place) { %><input type="hidden" name="placeId" value="<%= place.id %>"><% } %>
                <div class="field">
                  <label for="reply-reason-<%= reply.id %>">เหตุผล (ผู้เขียนจะเห็นข้อความนี้)</label>
                  <textarea id="reply-reason-<%= reply.id %>" name="reason" maxlength="500" rows="2" required></textarea>
                </div>
                <button class="button button-danger button-small" type="submit">นำความเห็นออก</button>
              </form>
            </details>
            <% } %>
          </li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <% if (review.status === 'active') { %>
      <details>
        <summary>นำรีวิวนี้ออก</summary>
        <form class="stack-form" action="/admin/reviews/<%= review.id %>/remove" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <input type="hidden" name="status" value="<%= status %>">
          <input type="hidden" name="page" value="<%= result.pagination.page %>">
          <% searchFields.forEach(([key, value]) => { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% }) %>
          <% if (place) { %><input type="hidden" name="placeId" value="<%= place.id %>"><% } %>
          <div class="field">
            <label for="reason-<%= review.id %>">เหตุผล (ผู้เขียนจะเห็นข้อความนี้)</label>
            <textarea id="reason-<%= review.id %>" name="reason" maxlength="500" rows="3" required></textarea>
          </div>
          <button class="button button-danger" type="submit">นำรีวิวออก</button>
        </form>
      </details>
      <% } %>
    </article>
    <% }) %>
  </div>

  <%- include('../partials/pagination', { pagination: result.pagination, pageLink }) %>
</div>
<%- include('../partials/foot') %>
