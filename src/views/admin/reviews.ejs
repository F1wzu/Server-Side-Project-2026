<%- include('../partials/head') %>
<%
  const statusLabels = { active: 'แสดงอยู่', deleted: 'ผู้เขียนลบแล้ว', removed: 'นำออกแล้ว' };
  const filters = [['all', 'ทั้งหมด'], ['active', 'แสดงอยู่'], ['removed', 'นำออกแล้ว'], ['deleted', 'ผู้เขียนลบแล้ว']];
%>
<div class="container narrow page-content">
  <%- include('../partials/admin-nav') %>
  <% if (place) { %>
  <nav class="breadcrumb" aria-label="ตำแหน่งหน้า">
    <a href="/admin/places">จัดการสถานที่</a><%- icon('chevron', 16) %>
    <span><%= place.name %></span>
  </nav>
  <%- include('../partials/admin-place-tabs', { place, current: 'reviews' }) %>
  <div class="page-heading">
    <h1>รีวิวของ <%= place.name %></h1>
    <p>นำรีวิวที่ไม่เหมาะสมออกพร้อมบันทึกเหตุผล คะแนนของสถานที่จะคำนวณใหม่ทันที รีวิวที่นำออกแล้วคืนค่าไม่ได้ และผู้เขียนจะเห็นเหตุผลนั้น</p>
    <p><a class="text-link" href="/places/<%= place.id %>">ดูหน้าสถานที่</a> · <a class="text-link" href="/admin/reviews">รีวิวทุกสถานที่</a></p>
  </div>
  <% } else { %>
  <div class="page-heading">
    <h1>ดูแลรีวิว</h1>
    <p>รีวิวจากทุกสถานที่ ใหม่สุดก่อน ถ้าต้องการดูทีละแห่ง ไปที่ <a class="text-link" href="/admin/places">จัดการสถานที่</a> แล้วกด "รีวิว" ของสถานที่นั้น รีวิวที่นำออกแล้วคืนค่าไม่ได้ และผู้เขียนจะเห็นเหตุผลนั้น</p>
  </div>
  <% } %>

  <nav class="tabs" aria-label="กรองตามสถานะ">
    <% filters.forEach(([key, label]) => { %>
    <a href="<%= listBase %><%= key === 'all' ? '' : '?status=' + key %>"<%- status === key ? ' aria-current="true"' : '' %>><%= label %></a>
    <% }) %>
  </nav>
  <p class="meta list-count"><%= result.pagination.total %> รีวิว</p>

  <% if (result.pagination.total === 0) { %>
  <div class="empty-state">
    <%- icon('star', 28) %>
    <h2>ไม่มีรีวิวในหมวดนี้</h2>
  </div>
  <% } %>

  <div class="review-management">
    <% result.data.forEach((review) => { %>
    <article class="panel managed-review">
      <div class="section-heading">
        <div>
          <% if (place) { %>
          <h2><%= review.user.username %></h2>
          <p class="meta"><%= date(review.createdAt) %></p>
          <% } else { %>
          <h2><a href="/admin/places/<%= review.place.id %>/reviews"><%= review.place.name %></a></h2>
          <p class="meta">โดย <%= review.user.username %> · <%= date(review.createdAt) %></p>
          <% } %>
        </div>
        <span class="status status-review-<%= review.status %>"><%= statusLabels[review.status] %></span>
      </div>
      <p><%- include('../partials/stars', { value: review.rating }) %></p>
      <p class="preserve-lines"><%= review.comment || 'ไม่มีข้อความเพิ่มเติม' %></p>

      <% if (review.status === 'removed') { %>
      <div class="feedback-panel"><strong>เหตุผลที่นำออก</strong><p><%= review.removedReason %></p></div>
      <% } %>

      <% if (review.replies && review.replies.length) { %>
      <div class="review-replies">
        <h3 class="meta">ความเห็นตอบกลับ <%= review.replies.length %> รายการ</h3>
        <ul class="reply-list">
          <% review.replies.forEach((reply) => { %>
          <li class="reply">
            <div class="reply-top">
              <strong><%= reply.user.username %></strong>
              <time class="meta" datetime="<%= reply.createdAt.toISOString() %>"><%= date(reply.createdAt) %></time>
              <span class="status status-review-<%= reply.status %>"><%= statusLabels[reply.status] %></span>
            </div>
            <p class="preserve-lines"><%= reply.body %></p>
            <% if (reply.status === 'removed') { %><p class="small-note">เหตุผลที่นำออก: <%= reply.removedReason %></p><% } %>
            <% if (reply.status === 'active') { %>
            <details>
              <summary>นำความเห็นนี้ออก</summary>
              <form class="stack-form" action="/admin/replies/<%= reply.id %>/remove" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                <input type="hidden" name="status" value="<%= status %>">
                <% if (place) { %><input type="hidden" name="placeId" value="<%= place.id %>"><% } %>
                <div class="field">
                  <label for="reply-reason-<%= reply.id %>">เหตุผล (ผู้เขียนจะเห็นข้อความนี้)</label>
                  <textarea id="reply-reason-<%= reply.id %>" name="reason" maxlength="500" rows="2" required></textarea>
                </div>
                <button class="button button-danger button-small" type="submit">นำความเห็นออก</button>
              </form>
            </details>
            <% } %>
          </li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <% if (review.status === 'active') { %>
      <details>
        <summary>นำรีวิวนี้ออก</summary>
        <form class="stack-form" action="/admin/reviews/<%= review.id %>/remove" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <input type="hidden" name="status" value="<%= status %>">
          <% if (place) { %><input type="hidden" name="placeId" value="<%= place.id %>"><% } %>
          <div class="field">
            <label for="reason-<%= review.id %>">เหตุผล (ผู้เขียนจะเห็นข้อความนี้)</label>
            <textarea id="reason-<%= review.id %>" name="reason" maxlength="500" rows="3" required></textarea>
          </div>
          <button class="button button-danger" type="submit">นำรีวิวออก</button>
        </form>
      </details>
      <% } %>
    </article>
    <% }) %>
  </div>

  <%- include('../partials/pagination', { pagination: result.pagination, pageLink }) %>
</div>
<%- include('../partials/foot') %>
