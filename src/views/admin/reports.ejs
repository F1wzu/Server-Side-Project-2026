<%- include('../partials/head') %>
<%
  const filters = [['open', 'รอตรวจ'], ['resolved', 'แก้ไขแล้ว'], ['dismissed', 'ไม่ดำเนินการ'], ['all', 'ทั้งหมด']];
  const statusLabels = { open: 'รอตรวจ', resolved: 'แก้ไขแล้ว', dismissed: 'ไม่ดำเนินการ' };
%>
<div class="container page-content">
  <%- include('../partials/admin-nav') %>
  <% if (place) { %>
  <nav class="breadcrumb" aria-label="ตำแหน่งหน้า">
    <a href="/admin/places">จัดการสถานที่</a><%- icon('chevron', 16) %>
    <span><%= place.name %></span>
  </nav>
  <%- include('../partials/admin-place-tabs', { place, current: 'reports' }) %>
  <div class="page-heading">
    <h1>แจ้งข้อมูลผิดของ <%= place.name %></h1>
    <p>แก้ข้อมูลในแท็บ “ข้อมูลสถานที่” แล้วกลับมาปิดรายการเป็น “แก้ไขแล้ว” หรือ “ไม่ดำเนินการ”</p>
    <p><a class="text-link" href="/places/<%= place.id %>">ดูหน้าสถานที่</a> · <a class="text-link" href="/admin/reports">แจ้งข้อมูลผิดทุกสถานที่</a></p>
  </div>
  <% } else { %>
  <div class="page-heading">
    <h1>แจ้งข้อมูลผิด</h1>
    <p>ตรวจข้อมูลสถานที่ตามที่สมาชิกแจ้ง แล้วปิดรายการเป็น “แก้ไขแล้ว” หรือ “ไม่ดำเนินการ” กดชื่อสถานที่เพื่อดูรายการแจ้งของสถานที่นั้นและแก้ข้อมูล</p>
  </div>
  <% } %>

  <nav class="tabs" aria-label="กรองตามสถานะ">
    <% filters.forEach(([key, label]) => { %>
    <a href="<%= listBase %><%= key === 'open' ? '' : '?status=' + key %>"<%- status === key ? ' aria-current="true"' : '' %>><%= label %></a>
    <% }) %>
  </nav>
  <p class="meta list-count"><%= result.pagination.total %> รายการ</p>

  <% if (result.pagination.total === 0) { %>
  <div class="empty-state">
    <%- icon('shield', 28) %>
    <h2>ไม่มีรายการในหมวดนี้</h2>
  </div>
  <% } else { %>
  <div class="table-shell">
    <table>
      <thead>
        <tr>
          <% if (!place) { %><th scope="col">สถานที่</th><% } %>
          <th scope="col">ผู้แจ้ง</th>
          <th scope="col">เหตุผล</th>
          <th scope="col">รายละเอียด</th>
          <th scope="col">วันที่แจ้ง</th>
          <th scope="col">การดำเนินการ</th>
        </tr>
      </thead>
      <tbody>
        <% result.data.forEach((report) => { %>
        <tr>
          <% if (!place) { %><td data-label="สถานที่"><a href="/admin/places/<%= report.place.id %>/reports"><%= report.place.name %></a></td><% } %>
          <td data-label="ผู้แจ้ง"><%= report.user.username %></td>
          <td data-label="เหตุผล"><%= reasonLabels[report.reason] %></td>
          <td data-label="รายละเอียด" class="preserve-lines"><%= report.details || '-' %></td>
          <td data-label="วันที่แจ้ง" class="table-date"><%= date(report.createdAt) %></td>
          <td data-label="การดำเนินการ">
            <% if (report.status === 'open') { %>
            <form action="/admin/reports/<%= report.id %>/resolve" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
              <input type="hidden" name="filter" value="<%= status %>">
              <% if (place) { %><input type="hidden" name="placeId" value="<%= place.id %>"><% } %>
              <button class="button button-outline button-small" type="submit" name="status" value="resolved">แก้ไขแล้ว</button>
              <button class="text-button" type="submit" name="status" value="dismissed">ไม่ดำเนินการ</button>
            </form>
            <% } else { %>
            <span class="status"><%= statusLabels[report.status] %></span>
            <% if (report.resolvedBy) { %><span class="meta">โดย <%= report.resolvedBy.username %></span><% } %>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <%- include('../partials/pagination', { pagination: result.pagination, pageLink }) %>
</div>
<%- include('../partials/foot') %>
