<%- include('partials/head') %>
<%
  const editing = Boolean(submission);
%>
<div class="container form-layout page-content">
  <div>
    <nav class="breadcrumb" aria-label="ตำแหน่งหน้า">
      <a href="/me/submissions">คำขอของฉัน</a><%- icon('chevron', 16) %>
      <span><%= editing ? 'แก้ไขคำขอ #' + submission.id : 'แนะนำสถานที่' %></span>
    </nav>
    <div class="page-heading">
      <h1><%= editing ? 'แก้ไขข้อมูลสถานที่' : 'แนะนำสถานที่ในย่าน' %></h1>
      <p>บอกข้อมูลที่คุณรู้จัก เพื่อให้ผู้ดูแลตรวจสอบก่อนเผยแพร่</p>
    </div>

    <% if (formError) { %>
    <div class="form-error" role="alert" id="form-error" tabindex="-1">
      <%= formError %>
      <% if (Object.keys(errors).length) { %>
      <ul>
        <% Object.entries(errors).forEach(([field, message]) => { %><li><%= message %></li><% }) %>
      </ul>
      <% } %>
      <% if (!errors.photo && values && Object.keys(values).length > 1) { %><p class="small-note">ถ้าแนบรูปไว้ กรุณาเลือกรูปอีกครั้ง</p><% } %>
    </div>
    <% } %>

    <form class="panel submission-form stack-form" method="post" enctype="multipart/form-data"
          action="<%= editing ? '/me/submissions/' + submission.id : '/submissions' %>" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <% if (editing) { %><input type="hidden" name="version" value="<%= submission.version %>"><% } %>

      <%- include('partials/place-fields', { values, errors, categories, bounds }) %>


      <div class="form-actions">
        <a class="button button-outline" href="<%= editing ? '/me/submissions/' + submission.id : '/me/submissions' %>">ยกเลิก</a>
        <button class="button button-primary" type="submit"><%= editing ? 'บันทึกการแก้ไข' : 'ส่งให้ผู้ดูแลตรวจสอบ' %></button>
      </div>
    </form>
  </div>

  <aside class="form-aside">
    <h2>ก่อนส่งคำขอ</h2>
    <ol>
      <li>เลือกสถานที่ในเขตลาดกระบัง</li>
      <li>ใช้ชื่อและที่อยู่ที่ตรวจสอบได้</li>
      <li>ปักหมุดให้ตรงตำแหน่งจริง</li>
      <li>ติดตามผลได้ที่ "คำขอของฉัน"</li>
    </ol>
    <p class="side-note"><%- icon('clock', 18) %><span>ข้อมูลจะเผยแพร่หลังผู้ดูแลอนุมัติ หากต้องแก้ไข คุณจะเห็นเหตุผลในหน้าคำขอ</span></p>
  </aside>
</div>
<%- include('partials/foot') %>
