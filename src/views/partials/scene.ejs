<%# Home page banner. Each page load shows one of three original Lat Krabang scenes, picked at random:
    rail = Lat Krabang station on the Airport Rail Link, kmitl = the KMITL campus, market = Hua Takhe old market on the canal.
    data-variant names the scene so it can be checked without looking at the drawing. %>
<% const sceneVariant = ['rail', 'kmitl', 'market'][Math.floor(Math.random() * 3)]; %>
<svg class="scene" viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false" data-variant="<%= sceneVariant %>">
  <%- include('scene-' + sceneVariant) %>
</svg>
