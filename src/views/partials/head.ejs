<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= siteName %></title>
  <meta name="description" content="ค้นหาที่กิน ที่เที่ยว ที่พัก และบริการในเขตลาดกระบัง พร้อมรีวิวจากคนในย่าน">
  <meta name="theme-color" content="#0e5a52">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preload" href="/fonts/text/ibm-plex-sans-thai-looped-thai-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/site.css">
  <script src="/js/site.js" defer></script>
  <% if (locals.withMap) { %>
  <link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
  <script src="/vendor/leaflet/leaflet.js" defer></script>
  <script src="/js/map.js" defer></script>
  <% } %>
</head>
<body>
<a class="skip-link" href="#main-content">ข้ามไปยังเนื้อหา</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="ไปไหนดี ลาดกระบัง หน้าแรก">
      <svg class="brand-mark" width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
        <path d="M20 3c-7.7 0-14 5.9-14 13.4C6 26.6 20 37 20 37s14-10.4 14-20.6C34 8.9 27.700 3 20 3Z" fill="#0e5a52"/>
        <circle cx="20" cy="13.500" r="4.200" fill="#f1b95a"/>
        <path d="M11 21.500q3-2.600 6 0t6 0 6 0" fill="none" stroke="#faf5ea" stroke-width="2.200" stroke-linecap="round"/>
      </svg>
      <span class="brand-text"><strong>ไปไหนดี</strong><small>ลาดกระบัง</small></span>
    </a>
    <button class="menu-toggle" type="button" aria-label="เปิดเมนู" aria-controls="site-nav" aria-expanded="false" data-menu><%- icon('menu', 24) %></button>
    <nav class="site-nav" id="site-nav" aria-label="เมนูหลัก">
      <% const here = (test) => (test ? ' aria-current="page"' : ''); %>
      <a href="/places"<%- here(currentPath.startsWith('/places')) %>>สำรวจ</a>
      <a href="/map"<%- here(currentPath === '/map') %>>แผนที่</a>
      <% if (currentUser) { %>
      <a href="/me/favorites"<%- here(currentPath === '/me/favorites') %>>ที่บันทึกไว้</a>
      <a href="/me/submissions"<%- here(currentPath.startsWith('/me/submissions')) %>>คำขอของฉัน</a>
      <% } %>
      <% if (currentUser?.role === 'admin') { %>
      <a href="/admin"<%- here(currentPath.startsWith('/admin')) %>>ผู้ดูแล</a>
      <% } %>
      <% if (currentUser) { %>
      <a class="button button-primary button-small" href="/submissions/new"><%- icon('plus', 18) %>แนะนำสถานที่</a>
      <a class="account-link" href="/me" aria-label="บัญชีของฉัน"<%- here(currentPath === '/me') %>><span class="avatar"><%= currentUser.username.slice(0, 1) %></span></a>
      <% } else { %>
      <a class="button button-outline button-small" href="/login"><%- icon('user', 18) %>เข้าสู่ระบบ</a>
      <% } %>
    </nav>
  </div>
</header>
<main id="main-content" class="page-main">
<% const flash = takeFlash(); %>
<% if (flash) { %><div class="container"><div class="notice<%= flash.type === 'error' ? ' notice-error' : '' %>" role="status" data-flash><%- icon(flash.type === 'error' ? 'info' : 'check') %><%= flash.text %></div></div><% } %>
