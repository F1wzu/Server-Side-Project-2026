// Database schema — see docs/DESIGN.md section 3 for the reasoning.
//
// Rules Prisma cannot express (CHECK constraints, the case-insensitive unique
// category name) are written by hand at the end of the migration SQL files.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  member
  admin

  @@map("role")
}

enum PlaceStatus {
  published
  unpublished

  @@map("place_status")
}

enum HoursState {
  open
  closed
  unknown

  @@map("hours_state")
}

enum ReviewStatus {
  active
  deleted
  removed

  @@map("review_status")
}

enum SubmissionStatus {
  pending
  changes_requested
  approved
  rejected

  @@map("submission_status")
}

enum SubmissionAction {
  submitted
  edited
  resubmitted
  returned
  approved
  rejected

  @@map("submission_action")
}

enum ReportReason {
  closed
  moved
  wrong_info
  other

  @@map("report_reason")
}

enum ReportStatus {
  open
  resolved
  dismissed

  @@map("report_status")
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @db.VarChar(50)
  email          String   @unique @db.VarChar(254)
  passwordHash   String   @map("password_hash") @db.VarChar(100)
  role           Role     @default(member)
  // Raised when the password changes. A session that remembers an older
  // value is treated as logged out (see middleware/auth.js).
  sessionVersion Int      @default(1) @map("session_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  reviews          Review[]          @relation("ReviewAuthor")
  removedReviews   Review[]          @relation("ReviewRemover")
  replies          ReviewReply[]     @relation("ReplyAuthor")
  removedReplies   ReviewReply[]     @relation("ReplyRemover")
  favorites        Favorite[]
  submissions      Submission[]
  submissionEvents SubmissionEvent[]
  createdPlaces    Place[]
  placeReports     PlaceReport[]     @relation("ReportAuthor")
  resolvedReports  PlaceReport[]     @relation("ReportResolver")

  @@map("users")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  places      Place[]
  submissions Submission[]

  @@map("categories")
}

model Place {
  id            Int         @id @default(autoincrement())
  categoryId    Int         @map("category_id")
  name          String      @db.VarChar(200)
  description   String
  address       String      @db.VarChar(500)
  latitude      Decimal?    @db.Decimal(9, 6)
  longitude     Decimal?    @db.Decimal(9, 6)
  imagePath     String?     @map("image_path") @db.VarChar(500)
  phone         String?     @db.VarChar(30)
  websiteUrl    String?     @map("website_url") @db.VarChar(500)
  status        PlaceStatus @default(published)
  featuredOrder Int?        @map("featured_order")
  ratingAvg     Decimal?    @map("rating_avg") @db.Decimal(3, 2)
  ratingCount   Int         @default(0) @map("rating_count")
  createdById   Int?        @map("created_by")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy  User?         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  hours      PlaceHours[]
  photos     PlacePhoto[]
  reviews    Review[]
  favorites  Favorite[]
  submission Submission?
  reports    PlaceReport[]

  @@index([status, categoryId])
  @@index([status, ratingAvg])
  @@map("places")
}

model PlaceHours {
  placeId       Int        @map("place_id")
  weekday       Int        @db.SmallInt
  state         HoursState @default(unknown)
  opensAt       DateTime?  @map("opens_at") @db.Time(0)
  closesAt      DateTime?  @map("closes_at") @db.Time(0)
  closesNextDay Boolean    @default(false) @map("closes_next_day")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([placeId, weekday])
  @@map("place_hours")
}

model Review {
  id            Int          @id @default(autoincrement())
  userId        Int          @map("user_id")
  placeId       Int          @map("place_id")
  rating        Int          @db.SmallInt
  comment       String?      @db.VarChar(2000)
  status        ReviewStatus @default(active)
  removedById   Int?         @map("removed_by")
  removedReason String?      @map("removed_reason") @db.VarChar(500)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User          @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Restrict)
  place     Place         @relation(fields: [placeId], references: [id], onDelete: Restrict)
  removedBy User?         @relation("ReviewRemover", fields: [removedById], references: [id], onDelete: Restrict)
  replies   ReviewReply[]

  @@unique([userId, placeId])
  @@index([placeId, status])
  @@map("reviews")
}

// A member's reply under a review: one level only (no replies to replies).
// Soft-deleted like reviews; an admin may remove one with a reason.
model ReviewReply {
  id            Int          @id @default(autoincrement())
  reviewId      Int          @map("review_id")
  userId        Int          @map("user_id")
  body          String       @db.VarChar(1000)
  status        ReviewStatus @default(active)
  removedById   Int?         @map("removed_by")
  removedReason String?      @map("removed_reason") @db.VarChar(500)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  review    Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  user      User   @relation("ReplyAuthor", fields: [userId], references: [id], onDelete: Restrict)
  removedBy User?  @relation("ReplyRemover", fields: [removedById], references: [id], onDelete: Restrict)

  @@index([reviewId, status, createdAt])
  @@map("review_replies")
}

// Gallery photos of a place besides its cover (places.image_path), in the
// order an admin chose. At most 9, so a place has at most 10 photos.
model PlacePhoto {
  id        Int      @id @default(autoincrement())
  placeId   Int      @map("place_id")
  imagePath String   @map("image_path") @db.VarChar(500)
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  // No two photos share a position. Swapping two photos goes through a
  // temporary position (see models/placePhoto.js).
  @@unique([placeId, position])
  @@map("place_photos")
}

model Favorite {
  userId    Int      @map("user_id")
  placeId   Int      @map("place_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
  @@index([placeId])
  @@map("favorites")
}

model Submission {
  id              Int              @id @default(autoincrement())
  userId          Int              @map("user_id")
  categoryId      Int              @map("category_id")
  name            String           @db.VarChar(200)
  description     String
  address         String           @db.VarChar(500)
  latitude        Decimal?         @db.Decimal(9, 6)
  longitude       Decimal?         @db.Decimal(9, 6)
  imagePath       String?          @map("image_path") @db.VarChar(500)
  // Photos 2 to 5 of the submission; image_path is the first (the cover).
  extraImagePaths String[]         @default([]) @map("extra_image_paths") @db.VarChar(500)
  phone           String?          @db.VarChar(30)
  websiteUrl      String?          @map("website_url") @db.VarChar(500)
  hours           Json
  status          SubmissionStatus @default(pending)
  version         Int              @default(1)
  reviewNote      String?          @map("review_note") @db.VarChar(1000)
  placeId         Int?             @unique @map("place_id")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  category Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  place    Place?            @relation(fields: [placeId], references: [id], onDelete: Restrict)
  events   SubmissionEvent[]

  @@index([status, createdAt])
  @@index([userId])
  @@map("submissions")
}

model SubmissionEvent {
  id           Int              @id @default(autoincrement())
  submissionId Int              @map("submission_id")
  actorId      Int              @map("actor_id")
  action       SubmissionAction
  note         String?          @db.VarChar(1000)
  snapshot     Json
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor      User       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@map("submission_events")
}

// "This information is wrong" from a member. One open report per member per
// place is enforced by a partial unique index written by hand in the migration.
model PlaceReport {
  id           Int          @id @default(autoincrement())
  placeId      Int          @map("place_id")
  userId       Int          @map("user_id")
  reason       ReportReason
  details      String?      @db.VarChar(1000)
  status       ReportStatus @default(open)
  resolvedById Int?         @map("resolved_by")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt   DateTime?    @map("resolved_at") @db.Timestamptz(6)

  place      Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user       User  @relation("ReportAuthor", fields: [userId], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("place_reports")
}

// Owned by the session store (connect-pg-simple, added in step 2).
// The column names and types are the ones that library expects.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("sessions")
}
